{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/games/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/bq-push",
      "schedule": "0 16 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/quiz",
      "destination": "/games/bereshit-quiz",
      "permanent": false
    },
    {
      "source": "/daily",
      "destination": "/games/bereshit-quiz?go=daily",
      "permanent": false
    },
    {
